# Copia questo file in `.env.local` e compila i valori.
# `.env.local` è ignorato da git: non finisce nel repository.

# --- Progetto Sanity (da https://manage.sanity.io) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Versione delle API Sanity. Lasciare così: bloccarla evita che un
# aggiornamento lato Sanity cambi le risposte senza preavviso.
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-27

# --- Token di scrittura (solo per l'import iniziale) ---
# manage.sanity.io -> API -> Tokens -> Add API token, permessi di scrittura.
# Serve una sola volta per `npm run sanity:import`. Non serve in produzione.
SANITY_API_WRITE_TOKEN=

# --- Webhook di revalidation ---
# Una stringa casuale qualsiasi. Va incollata identica nel webhook
# configurato su manage.sanity.io -> API -> Webhooks.
SANITY_REVALIDATE_SECRET=
